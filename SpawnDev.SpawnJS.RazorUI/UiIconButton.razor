@inherits UiComponentBase

@* A circular ghost icon button - the building block of toolbars and media controls. Renders a named UiIcon
   (or arbitrary ChildContent), forwards clicks, and carries an aria-label since an icon has no text. *@
<button class="@CssClass("ui-icon-button")" style="@Style(null)" type="button"
        aria-label="@AriaLabel" @onclick="OnClickAsync" @attributes="PassThroughAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <UiIcon Name="@Icon" Size="@IconSize" />
    }
</button>

@code {
    /// <summary>Named icon to render (see <see cref="UiIcon"/>). Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Icon size in pixels. Default 24.</summary>
    [Parameter] public double IconSize { get; set; } = 24;

    /// <summary>Accessible label (required for a meaningful button, since the icon has no text).</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Custom button content instead of a named icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Invoked when the button is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    async Task OnClickAsync() => await OnClick.InvokeAsync();
}
