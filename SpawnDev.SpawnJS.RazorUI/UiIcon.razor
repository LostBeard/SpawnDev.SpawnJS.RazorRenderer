@inherits UiComponentBase

@* Inline-SVG icon set with hand-authored 24x24 geometry (no external font/sprite). Filled shapes use the
   svg's fill=currentColor; outline shapes set fill=none/stroke=currentColor per element. Add icons by adding
   a case. Media set first: play/pause/stop/skip/volume/fullscreen. *@
<svg class="@CssClass("ui-icon")" style="@Style(null)" viewBox="0 0 24 24"
     width="@Inv(Size)" height="@Inv(Size)" fill="currentColor" aria-hidden="true" @attributes="PassThroughAttributes">
    @switch (Name)
    {
        case "play":
            <polygon points="8,5 19,12 8,19" />
            break;
        case "pause":
            <rect x="6" y="5" width="4" height="14" rx="1" />
            <rect x="14" y="5" width="4" height="14" rx="1" />
            break;
        case "stop":
            <rect x="6" y="6" width="12" height="12" rx="1.5" />
            break;
        case "skip-next":
            <polygon points="6,5 15,12 6,19" />
            <rect x="16" y="5" width="3" height="14" rx="1" />
            break;
        case "skip-previous":
            <rect x="5" y="5" width="3" height="14" rx="1" />
            <polygon points="18,5 9,12 18,19" />
            break;
        case "volume":
            <polygon points="3,9 7,9 11,5 11,19 7,15 3,15" />
            <path d="M14 8.5 A5 5 0 0 1 14 15.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path d="M16.5 6 A9 9 0 0 1 16.5 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            break;
        case "volume-mute":
            <polygon points="3,9 7,9 11,5 11,19 7,15 3,15" />
            <path d="M15 9 L20 15 M20 9 L15 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            break;
        case "fullscreen":
            <path d="M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "fullscreen-exit":
            <path d="M9 4 V9 H4 M20 9 H15 V4 M15 20 V15 H20 M4 15 H9 V20"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            break;
    }
</svg>

@code {
    /// <summary>Icon name (e.g. <c>play</c>, <c>pause</c>, <c>volume</c>, <c>fullscreen</c>).</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Rendered size in pixels (square). Default 24.</summary>
    [Parameter] public double Size { get; set; } = 24;

    static string Inv(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
