{
  "manifest_version": 3,
  "name": "RazorRendererDemo",
  "version": "1.0",
  "description": "RazorRendererDemo demonstrates SpawnJS and SpawnJS.RazorUI in a browser extension.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "wwwroot/content.js" ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "wwwroot/*" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
