@using RazorRendererDemo.Components
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.WebWorkers
@inject SpawnJSRuntime JS
@inject WebWorkerService WebWorkerService
@inject RazorUITheme ThemeService
@implements IDisposable



<div>
    <h3>App</h3>
    <button class="test-button-1" @onclick="IncrementCount">Clicked @count times</button>
    <SomeInfo Name="@name"></SomeInfo>
    <input class="name-input" @bind="name" @bind:event="oninput" />
    <button @onclick="RunWorkerTest">Run Worker Test</button>
    <button @onclick="ToggleVideoPlayer">Toggle Video Player</button>
    @if (_showVideoPlayer)
    {
        <VideoPlayerA />
    }
    <KeyedListTest />

    <UiCard Title="RazorUI">
        A themeable component library rendered by SpawnDomRenderer, styled by a stylesheet adopted into this shadow root.
        <UiStack Gap="0.6rem" style="margin-top:.75rem;">
            <UiInput @bind-Value="name" placeholder="Type here" />
            <UiStack Horizontal="true" Gap="0.5rem">
                <UiButton OnClick="IncrementCount" id="primary-btn" data-test="splat" class="demo-extra">Primary (@count)</UiButton>
                <UiButton Secondary="true" OnClick="ToggleTheme">Toggle theme</UiButton>
                <UiButton Secondary="true" OnClick="@(() => _dialogOpen = true)">Open dialog</UiButton>
            </UiStack>
        </UiStack>
    </UiCard>

    <UiDialog @bind-Open="_dialogOpen" Title="Hello from RazorUI">
        This dialog is rendered by SpawnDomRenderer and styled by the adopted RazorUI sheet. Click the backdrop to close.
    </UiDialog>
    <SimpleRedSquare />
</div>


@code {
    int count = 0;
    string name = "User first name maybe";

    void IncrementCount() => count++;

    WebWorker? _worker;

    bool _showVideoPlayer = false;

    async Task RunWorkerTest()
    {
        _worker ??= await WebWorkerService.GetWebWorker();
        // the below line will print "Hello from Window" to the console from inside
        await _worker!.Run(() => Console.WriteLine($"Hello from {JS.GlobalScopeName}"));
    }

    void ToggleVideoPlayer()
    {
        _showVideoPlayer = !_showVideoPlayer;
    }

    bool _dialogOpen;
    bool _dark;
    void ToggleTheme()
    {
        _dark = !_dark;
        // Live theme swap - restyles every root the shared theme sheet was adopted into, no re-render.
        ThemeService.SetTheme(_dark ? RazorUITheme.Dark : RazorUITheme.Light);
    }

    public void Dispose()
    {
        _worker?.Dispose();
    }
}
