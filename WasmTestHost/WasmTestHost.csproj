<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestsShared\TestsShared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
	</ItemGroup>
	<!-- A trimmed publish (-p:PublishTrimmed=true, TrimMode=full) tests the LIBRARIES for trim safety. The host and the
	     test assembly are rooted whole: tests are found by reflection, and a trimmed away test would vanish from the run. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="WasmTestHost" />
		<TrimmerRootAssembly Include="TestsShared" />
	</ItemGroup>
</Project>
