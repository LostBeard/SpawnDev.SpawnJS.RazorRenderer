<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>2.2.1-local.1</Version>
		<PackageReleaseNotes>v2.2.0 - Trim and NativeAOT safe (IsTrimmable, IsAotCompatible, IL warnings are build errors); component types carry DynamicallyAccessedMembers(All), as Blazor's own Renderer APIs do. On SpawnDev.SpawnJS 3.0.0. The test suite passes on a fully trimmed publish (TrimMode=full).</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.SpawnJS.RazorRenderer</Title>
		<Authors>LostBeard</Authors>
		<Description>Interactive Blazor components in .NET WebAssembly without the Blazor JS runtime. Renders Razor components straight to the real DOM through SpawnJS - @onclick, @bind, StateHasChanged, component lifecycle and EventCallbacks all work - and mounts them into any element or shadow root, so Blazor UI can be loaded onto any page (even from a CDN link) with full DOM/CSS isolation.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.RazorRenderer</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.SpawnJS.RazorRenderer.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>DotNetWebAssembly;Browser;UserInterface;Razor</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<!-- Trim and NativeAOT safe, enforced: the analyzers run on every build and any IL2xxx/IL3xxx warning fails it. -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114;IL3050;IL3051</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.2-local.1" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

</Project>
